];
---

<BaseLayout
  title="专线机场 // 2026 优质专线机场实测与套餐推荐 · ANTIGRAVITY"
  description="反重力网络实验室严选实测优质专线机场。现代 SaaS 仪表盘风横排矩阵，覆盖 IPLC 专线、平民月付与不限时按量流量包。"
>
  <div class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 顶部导言区 (现代极客仪表盘标头) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-md text-xs font-mono font-bold bg-blue-500/10 text-blue-600 dark:text-cyan-400 border border-blue-500/20 mb-3">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span>// 2026 BENCHMARK & AIRPORT SELECTION</span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
          专线机场实测与套餐推荐
        </h1>
        <p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-2xl">
          采用 Bento 数据矩阵与紧凑横排设计，剔除传统笨重卡片堆叠。数据指标基于 72 小时晚高峰真实压测，支持按需展开套餐对比。
        </p>
      </div>

      <!-- 实时压测摘要微看板 -->
      <div class="flex items-center space-x-3 px-3.5 py-2 rounded-xl bg-slate-100 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 text-xs font-mono shrink-0">
        <span class="flex items-center space-x-1.5 text-emerald-600 dark:text-emerald-400 font-semibold">
          <span class="pulse-indicator">
            <span class="pulse-indicator-dot"></span>
          </span>
          <span>巡检中: 15 家严选专线</span>
        </span>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <span class="text-slate-500 dark:text-slate-400">平均晚高峰 RTT: 20ms</span>
      </div>
    </div>

    <!-- 顶部轻量统计与筛选栏 (分类 Tab + 排序下拉) -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 p-2 rounded-xl bg-slate-100/80 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800 text-xs font-mono">
      
      <!-- 快速分类 Tab -->
      <div class="flex flex-wrap items-center gap-1.5" id="category-tabs">
        <button
          type="button"
          class="tab-btn active px-3 py-1.5 rounded-lg bg-white dark:bg-slate-800 text-blue-600 dark:text-cyan-400 font-bold shadow-xs transition cursor-pointer"
          data-filter="all"
        >
          全部 ({airportList.length})
        </button>
        <button
          type="button"
          class="tab-btn px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition cursor-pointer"
          data-filter="iplc"
        >
          旗舰专线 IPLC/IEPL
        </button>
        <button
          type="button"
          class="tab-btn px-3 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition cursor-pointer"
          data-filter="streaming"
        >
          原生流媒体/AI满血
        </button>
      </div>

      <!-- 排序下拉选项 -->
      <div class="flex items-center space-x-2 pl-2">
        <span class="text-slate-400 text-[11px] shrink-0 font-sans">排序方式:</span>
        <select
          id="sort-select"
          class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-2.5 py-1 text-slate-700 dark:text-slate-200 text-xs font-mono focus:outline-none focus:ring-1 focus:ring-blue-500 cursor-pointer"
        >
          <option value="rank-asc">综合排名 (推荐)</option>
          <option value="price-asc">起步价格 (低到高)</option>
          <option value="years-desc">运营年限 (长到短)</option>
        </select>
      </div>

    </div>

    <!-- 机场紧凑列表区 -->
    <div id="airports-list" class="space-y-4 mb-16">
      {airportList.map((airport) => (
        <AirportCard
          id={airport.id}
          rank={airport.rank}
          name={airport.name}
          operatingYears={airport.operatingYears}
          lineTags={airport.lineTags}
          category={airport.category}
          latencyStatus={airport.latencyStatus}
          unlockRating={airport.unlockRating}
          protocols={airport.protocols}
          startingPrice={airport.startingPrice}
          discountBadge={airport.discountBadge}
          couponCode={airport.couponCode}
          targetUrl={airport.targetUrl}
          verdict={airport.verdict}
          plans={airport.plans}
        />
      ))}
    </div>

    <!-- 底部实测避坑与评选准则 -->
    <div class="p-6 rounded-2xl bg-slate-50 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800/80">
      <h3 class="text-sm font-bold text-slate-900 dark:text-white mb-2 flex items-center space-x-2">
        <span>🛡️ 反重力网络实测评选准则</span>
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs text-slate-600 dark:text-slate-400 leading-relaxed font-sans">
        <div class="p-3 rounded-xl bg-white dark:bg-slate-800/50 border border-slate-200/70 dark:border-slate-800">
          <strong class="text-slate-800 dark:text-slate-200 block mb-1">1. 严控运营资质与冗余</strong>
          仅收录持续稳定运营 2 年以上、具备物理双中继容灾的成熟服务商，杜绝超卖跑路小作坊。
        </div>
        <div class="p-3 rounded-xl bg-white dark:bg-slate-800/50 border border-slate-200/70 dark:border-slate-800">
          <strong class="text-slate-800 dark:text-slate-200 block mb-1">2. 晚高峰 21:00 真实复测</strong>
          所有延迟与丢包指标均在晚高峰骨干网压测获取，不采信清晨空载或本地缓存数据。
        </div>
        <div class="p-3 rounded-xl bg-white dark:bg-slate-800/50 border border-slate-200/70 dark:border-slate-800">
          <strong class="text-slate-800 dark:text-slate-200 block mb-1">3. 推荐主备双持组合</strong>
          建议选购主力 IEPL 专线搭配一份永久不过期的应急按量随行包，在海缆割接时从容应对。
        </div>
      </div>
    </div>

  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. 优惠码自动复制与气泡提示
    document.querySelectorAll('.copy-coupon-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const code = btn.getAttribute('data-coupon');
        if (!code) return;

        try {
          await navigator.clipboard.writeText(code);
        } catch (_) {
          const input = document.createElement('input');
          input.value = code;
          document.body.appendChild(input);
          input.select();
          document.execCommand('copy');
          document.body.removeChild(input);
        }

        const tip = btn.querySelector('.copy-badge-tip');
        if (tip) {
          tip.classList.remove('hidden');
          setTimeout(() => {
            tip.classList.add('hidden');
          }, 2000);
        }
      });
    });

    // 3. 分类 Tab 快速筛选
    const tabBtns = document.querySelectorAll('.tab-btn');
    const cards = Array.from(document.querySelectorAll('.airport-card-container'));

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => {
          b.classList.remove('active', 'bg-white', 'dark:bg-slate-800', 'text-blue-600', 'dark:text-cyan-400', 'font-bold', 'shadow-xs');
          b.classList.add('text-slate-600', 'dark:text-slate-400');
        });

        btn.classList.add('active', 'bg-white', 'dark:bg-slate-800', 'text-blue-600', 'dark:text-cyan-400', 'font-bold', 'shadow-xs');
        btn.classList.remove('text-slate-600', 'dark:text-slate-400');

        const filter = btn.getAttribute('data-filter');

        cards.forEach(card => {
          const cat = card.getAttribute('data-category');
          if (filter === 'all') {
            card.classList.remove('hidden');
          } else if (filter === 'streaming') {
            // All top 2 cards support full streaming
            if (cat === 'iplc' || cat === 'monthly') {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          } else if (cat === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    // 4. 排序下拉切换
    const sortSelect = document.getElementById('sort-select');
    const listContainer = document.getElementById('airports-list');

    if (sortSelect && listContainer) {
      sortSelect.addEventListener('change', () => {
        const val = sortSelect.value;
        const currentCards = Array.from(document.querySelectorAll('.airport-card-container'));

        currentCards.sort((a, b) => {
          if (val === 'price-asc') {
            return parseFloat(a.getAttribute('data-price')) - parseFloat(b.getAttribute('data-price'));
          } else if (val === 'years-desc') {
            return parseInt(b.getAttribute('data-years')) - parseInt(a.getAttribute('data-years'));
          } else {
            return parseInt(a.getAttribute('data-rank')) - parseInt(b.getAttribute('data-rank'));
          }
        });

        currentCards.forEach(c => listContainer.appendChild(c));
      });
    }
  });
</script>
