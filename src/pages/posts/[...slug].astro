---
// src/pages/posts/[...slug].astro
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const isSpecialPost = post.slug === 'tls13-ech-zero-rtt-handshake-optimization-2026';
const pageTitle = isSpecialPost ? post.data.title : `${post.data.title} // 反重力网络实验室`;
const canonical = isSpecialPost ? 'https://netlabvpn.vip/articles/tls13-ech-zero-rtt-handshake-optimization-2026.html' : undefined;
---

<BaseLayout
  title={pageTitle}
  description={post.data.description}
  canonical={canonical}
>
  <div class="py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      
      <!-- 面包屑导航 -->
      <nav class="flex items-center space-x-2 text-xs font-mono text-slate-500 dark:text-slate-400 mb-8">
        <a href="/" class="hover:text-blue-500 transition-colors">全景观测</a>
        <span>/</span>
        <a href="/posts" class="hover:text-blue-500 transition-colors">实测长文</a>
        <span>/</span>
        <span class="text-slate-800 dark:text-slate-200 truncate">{post.data.title}</span>
      </nav>

      <!-- 文章头部元信息 -->
      <header class="mb-10 pb-8 border-b border-slate-200 dark:border-slate-800">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-md bg-blue-100 dark:bg-blue-950/80 text-blue-700 dark:text-blue-300">
            {post.data.category}
          </span>
          {post.data.badge && (
            <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-md bg-amber-100 dark:bg-amber-950/80 text-amber-700 dark:text-amber-300 border border-amber-300 dark:border-amber-700">
              ★ {post.data.badge}
            </span>
          )}
          <span class="text-xs font-mono text-slate-500 dark:text-slate-400 ml-auto">
            预计阅读时间：{post.data.readTime}
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
          {post.data.title}
        </h1>

        <p class="mt-4 text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
          {post.data.description}
        </p>

        <!-- 作者与日期 -->
        <div class="mt-6 flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-slate-100 dark:border-slate-800 text-xs font-mono text-slate-500 dark:text-slate-400">
          <div class="flex items-center space-x-2">
            <span class="w-6 h-6 rounded-full bg-gradient-to-tr from-blue-600 to-cyan-500 flex items-center justify-center text-white text-xs font-bold">
              AG
            </span>
            <span>撰稿人：{post.data.author}</span>
          </div>
          <div>
            发布日期：{post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
          </div>
        </div>
      </header>

      <!-- 文章正文排版渲染 -->
      <article class="prose prose-slate dark:prose-invert prose-headings:font-bold prose-headings:tracking-tight prose-a:text-blue-600 dark:prose-a:text-cyan-400 hover:prose-a:underline prose-code:font-mono prose-code:text-sm prose-pre:rounded-xl prose-pre:border prose-pre:border-slate-800 max-w-none">
        <Content />
      </article>

      <!-- 底部标签与操作栏 -->
      <div class="mt-14 pt-8 border-t border-slate-200 dark:border-slate-800">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-xs font-mono text-slate-400">相关标签：</span>
            {post.data.tags.map((tag) => (
              <span class="text-xs font-mono px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                #{tag}
              </span>
            ))}
          </div>
          <a href="/posts" class="text-xs font-mono font-semibold px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white transition-colors">
            ← 返回长文专栏列表
          </a>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>
