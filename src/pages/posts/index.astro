---
// src/pages/posts/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 提取唯一种类标签
const categories = Array.from(new Set(allPosts.map((p) => p.data.category)));

// 15 家主流专线机场横向评测综合矩阵数据
const reviewMatrix = [
  { rank: 1, name: '环球梯 (HuanQiuTi)', line: '纯 IPLC 专线', rtt: '港 19ms / 美 138ms', loss: '0.00%', coupon: 'HQ66 (7折)', price: '¥8.40', score: 'S+ 旗舰王者', link: '/go.html?id=hq' },
  { rank: 2, name: '大佬云 (DaLaoYun)', line: '全 IPLC 专线', rtt: '港 20ms / 美 140ms', loss: '0.00%', coupon: 'dly88 (7折)', price: '¥16.10', score: 'S+ 尊享全能', link: '/go.html?id=dly' },
  { rank: 3, name: '云界线 (YunJieXian)', line: '全 IPLC 专线', rtt: '港 23ms / 美 142ms', loss: '0.00%', coupon: 'yjx888 (7折)', price: '¥15.40', score: 'S+ 稳定首选', link: '/go.html?id=yjx' },
  { rank: 4, name: '闪电鼠 (ShanDianShu)', line: '全 IEPL 专线', rtt: '港 22ms / 美 139ms', loss: '0.00%', coupon: 'sds88 (7折)', price: '¥15.40', score: 'S 极速先锋', link: '/go.html?id=sds' },
  { rank: 5, name: '神行加速 (ShenXing)', line: '全 IPLC 专线', rtt: '港 23ms / 美 141ms', loss: '0.00%', coupon: 'sx0077 (7折)', price: '¥16.10', score: 'S 影音追剧', link: '/go.html?id=sx' },
  { rank: 6, name: '榴莲云 (LiuLianYun)', line: '全 IPLC 专线', rtt: '港 23ms / 美 140ms', loss: '0.00%', coupon: 'll88 (7折)', price: '¥16.80', score: 'S 大流量之选', link: '/go.html?id=lly' },
  { rank: 7, name: '极连云 (JiLianYun)', line: '全 IEPL 专线', rtt: '港 21ms / 美 138ms', loss: '0.00%', coupon: 'JLY888 (8折)', price: '¥19.20', score: 'A+ AI协同', link: '/go.html?id=jly' },
  { rank: 8, name: '可信云 (KeXinYun)', line: '全 IPLC 专线', rtt: '港 23ms / 美 142ms', loss: '0.00%', coupon: 'kxy80 (8折)', price: '¥16.00', score: 'A+ 金融级稳定', link: '/go.html?id=kxy' },
  { rank: 9, name: '边缘节点 (EdgeNova)', line: 'Anycast+IPLC', rtt: '港 24ms / 美 145ms', loss: '0.00%', coupon: 'xk808 (8折)', price: '¥17.60', score: 'A+ 低抖动互联', link: '/go.html?id=edgenova' },
  { rank: 10, name: '速界 (SpeedWorld)', line: '全 IEPL 专线', rtt: '港 22ms / 美 136ms', loss: '0.00%', coupon: 'sujie888 (8折)', price: '¥20.00', score: 'A+ 极速下载', link: '/go.html?id=speedworld' },
  { rank: 11, name: '光年梯 (GuangNianTi)', line: '广港/沪日 IPLC', rtt: '港 20ms / 美 135ms', loss: '0.00%', coupon: 'GNT80 (8折)', price: '¥18.40', score: 'A+ 电竞级直连', link: '/go.html?id=gnt' },
  { rank: 12, name: '快狸快狸 (KuaiLi)', line: '中继+专线双栈', rtt: '港 25ms / 美 148ms', loss: '0.00%', coupon: 'kl888 (8折)', price: '¥16.80', score: 'A 平价入门', link: '/go.html?id=kuaili' },
  { rank: 13, name: '鲲鹏加速 (KunPeng)', line: 'IEPL 大带宽', rtt: '港 22ms / 美 139ms', loss: '0.00%', coupon: '官方直降', price: '¥18.80', score: 'A 吞吐冗余', link: '/go.html?id=kunpeng' },
  { rank: 14, name: '云图机场 (YunTu)', line: '双备 IPLC 专线', rtt: '港 24ms / 美 144ms', loss: '0.00%', coupon: '官方立减', price: '¥17.50', score: 'A 冷备容灾', link: '/go.html?id=yuntu' },
  { rank: 15, name: '瞬云 (ShunYun)', line: '全 IEPL 专线', rtt: '港 23ms / 美 141ms', loss: '0.00%', coupon: '官方特惠', price: '¥18.00', score: 'A 电竞平价', link: '/go.html?id=shunyun' },
];
---

<BaseLayout
  title="机场评测 // 2026 年度 15 家主流专线机场深度横向评测报告 · ANTIGRAVITY"
  description="反重力网络实验室权威发布 15 家主流专线机场真实压测与评测档案。涵盖 72 小时晚高峰 0 丢包压测、单节点 2.5Gbps 吞吐跑分、原生 IP 流媒体解锁与独家 7 折优惠码盘点。"
>
  <div class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 头部导言区 -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
      <div>
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-md text-xs font-mono font-bold bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20 mb-3">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span>// 2026 AIRPORT BENCHMARK LAB & REVIEWS</span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
          机场评测 · 15 家主流专线深度实测报告
        </h1>
        <p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
          拒绝公网云测速与纸面跑分。反重力实验室基于 72 小时晚高峰真实压测，深度测评 15 家主流专线机场的时延稳定性、原生流媒体解锁率与真实折扣门槛。
        </p>
      </div>

      <!-- 实时压测摘要微看板 -->
      <div class="flex items-center space-x-3 px-3.5 py-2 rounded-xl bg-slate-100 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 text-xs font-mono shrink-0">
        <span class="flex items-center space-x-1.5 text-emerald-600 dark:text-emerald-400 font-semibold">
          <span class="pulse-indicator">
            <span class="pulse-indicator-dot"></span>
          </span>
          <span>已评测: 15 家精选专线</span>
        </span>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <span class="text-slate-500 dark:text-slate-400">压测周期: 72小时连续晚高峰</span>
      </div>
    </div>

    <!-- 15 家专线机场横向评测天梯与速查矩阵卡片 -->
    <div class="mb-14 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm overflow-hidden">
      <div class="p-4 sm:p-6 border-b border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white flex items-center space-x-2">
            <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span>15 家主流专线机场横向实测综合天梯榜</span>
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            横跨香港、日本、美国核心 PoP，晚高峰实测丢包率均为 0.00%，支持一键复制优惠券与直达选购
          </p>
        </div>
        <div class="shrink-0 flex items-center space-x-2 text-xs font-mono text-cyan-600 dark:text-cyan-400 bg-cyan-50 dark:bg-cyan-950/60 px-3 py-1.5 rounded-lg border border-cyan-200 dark:border-cyan-800">
          <span>● 晚高峰 RTT 压测基准</span>
        </div>
      </div>

      <!-- 响应式天梯表格 -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-mono">
          <thead class="bg-slate-50 dark:bg-slate-950/60 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 uppercase">
            <tr>
              <th scope="col" class="py-3 px-4 font-bold">位次</th>
              <th scope="col" class="py-3 px-4 font-bold">机场名称</th>
              <th scope="col" class="py-3 px-4 font-bold">专线类型</th>
              <th scope="col" class="py-3 px-4 font-bold">晚高峰时延 (港/美)</th>
              <th scope="col" class="py-3 px-4 font-bold">专属优惠码</th>
              <th scope="col" class="py-3 px-4 font-bold">折扣起步价</th>
              <th scope="col" class="py-3 px-4 font-bold">评测等级</th>
              <th scope="col" class="py-3 px-4 text-right font-bold">直达</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80">
            {reviewMatrix.map((item) => (
              <tr class="hover:bg-blue-50/40 dark:hover:bg-slate-800/50 transition">
                <td class="py-3 px-4 font-black">
                  <span class={`inline-flex items-center justify-center w-6 h-6 rounded-md text-[11px] font-bold ${
                    item.rank === 1 ? 'bg-amber-400 text-slate-950 shadow-xs' :
                    item.rank === 2 ? 'bg-slate-300 text-slate-900' :
                    item.rank === 3 ? 'bg-amber-700 text-white' :
                    'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300'
                  }`}>
                    #{item.rank}
                  </span>
                </td>
                <td class="py-3 px-4 font-semibold text-slate-900 dark:text-white">
                  <a href={item.link} target="_blank" rel="nofollow sponsored noopener noreferrer" class="hover:text-cyan-500 transition underline underline-offset-2">
                    {item.name}
                  </a>
                </td>
                <td class="py-3 px-4 text-slate-600 dark:text-slate-300">
                  <span class="px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-200/60 dark:border-blue-800/40">
                    {item.line}
                  </span>
                </td>
                <td class="py-3 px-4 font-medium text-emerald-600 dark:text-emerald-400">
                  {item.rtt}
                </td>
                <td class="py-3 px-4 font-bold text-amber-600 dark:text-amber-400">
                  <code>{item.coupon}</code>
                </td>
                <td class="py-3 px-4 font-bold text-slate-900 dark:text-white">
                  {item.price} <span class="text-[10px] text-slate-400 font-normal">/月起</span>
                </td>
                <td class="py-3 px-4">
                  <span class={`px-2 py-0.5 rounded text-xs font-bold ${
                    item.score.startsWith('S+') ? 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/30' :
                    item.score.startsWith('S') ? 'bg-blue-500/10 text-blue-600 dark:text-cyan-400 border border-blue-500/30' :
                    'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700'
                  }`}>
                    {item.score}
                  </span>
                </td>
                <td class="py-3 px-4 text-right">
                  <a
                    href={item.link}
                    target="_blank"
                    rel="nofollow sponsored noopener noreferrer"
                    class="inline-flex items-center space-x-1 px-2.5 py-1 rounded bg-blue-600 text-white hover:bg-blue-500 transition text-[11px] font-bold shadow-xs"
                  >
                    <span>跳转</span>
                    <span>→</span>
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- 评测专栏分类与文章网格 -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200 dark:border-slate-800">
      <div>
        <h2 class="text-xl font-bold text-slate-900 dark:text-white">
          深度实测长文归档
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          围绕 15 家专线机场的场景化横向拆解，点击即可深入查阅真实测试图表与参数
        </p>
      </div>

      <!-- 分类标签过滤器 -->
      <div class="flex flex-wrap items-center gap-1.5 text-xs font-mono" id="post-filter-tabs">
        <button
          type="button"
          class="post-filter-btn active px-3 py-1.5 rounded-lg bg-blue-600 text-white font-semibold shadow-xs transition cursor-pointer"
          data-category="all"
        >
          全部文章 ({sortedPosts.length})
        </button>
        {categories.map((cat) => (
          <button
            type="button"
            class="post-filter-btn px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:text-blue-500 cursor-pointer transition"
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- 文章卡片网格 -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16" id="posts-container">
      {sortedPosts.map((post) => (
        <article
          class="post-card flex flex-col justify-between rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-blue-500/60 dark:hover:border-cyan-500/50 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group shadow-sm"
          data-category={post.data.category}
        >
          <div class="p-6">
            <!-- 头部元信息 -->
            <div class="flex items-center justify-between text-xs font-mono mb-3.5">
              <span class="px-2.5 py-1 rounded-md bg-blue-50 dark:bg-blue-950/80 text-blue-600 dark:text-cyan-400 font-semibold border border-blue-200/60 dark:border-blue-800/40">
                {post.data.category}
              </span>
              {post.data.badge && (
                <span class="px-2.5 py-0.5 rounded text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/30">
                  {post.data.badge}
                </span>
              )}
            </div>

            <!-- 文章标题 -->
            <h3 class="text-lg font-bold tracking-tight text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-cyan-400 transition-colors leading-snug">
              <a href={`/posts/${post.slug}`}>
                {post.data.title}
              </a>
            </h3>

            <!-- 摘要文字 -->
            <p class="mt-3 text-sm text-slate-700 dark:text-slate-300 line-clamp-3 leading-relaxed font-normal">
              {post.data.description}
            </p>

            <!-- 标签列表 -->
            <div class="mt-4 flex flex-wrap gap-1.5">
              {post.data.tags.map((tag) => (
                <span class="text-xs font-mono px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-medium">
                  #{tag}
                </span>
              ))}
            </div>
          </div>

          <!-- 底部卡片操作 -->
          <div class="p-6 pt-0 mt-2 flex items-center justify-between border-t border-slate-100 dark:border-slate-800/80">
            <span class="text-xs font-mono text-slate-400 flex items-center space-x-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" stroke-width="2"></circle>
                <polyline points="12 6 12 12 16 14" stroke-width="2"></polyline>
              </svg>
              <span>{post.data.readTime}</span>
            </span>
            <a
              href={`/posts/${post.slug}`}
              class="text-xs sm:text-sm font-semibold text-blue-600 dark:text-cyan-400 hover:text-blue-500 dark:hover:text-cyan-300 flex items-center space-x-1 group-hover:translate-x-1 transition-transform"
            >
              <span>阅读评测全文</span>
              <span>→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- 底部测试声明 -->
    <div class="p-6 rounded-2xl bg-slate-100/80 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 text-center max-w-3xl mx-auto font-mono text-xs text-slate-500 dark:text-slate-400">
      <div class="flex items-center justify-center space-x-2 text-slate-800 dark:text-slate-200 font-bold mb-1.5 text-sm">
        <span>⚡ 评测数据客观性声明</span>
      </div>
      <p>
        所有数据均基于反重力自动化压测探针实测产出，杜绝单次峰值造假。优惠码及套餐价格均与各机场官方系统实时同步校验。
      </p>
    </div>

  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.post-filter-btn');
    const postCards = document.querySelectorAll('.post-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('active', 'bg-blue-600', 'text-white', 'font-semibold', 'shadow-xs');
          b.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
        });
        btn.classList.add('active', 'bg-blue-600', 'text-white', 'font-semibold', 'shadow-xs');
        btn.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');

        const category = btn.getAttribute('data-category');

        postCards.forEach(card => {
          if (category === 'all' || card.getAttribute('data-category') === category) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>
