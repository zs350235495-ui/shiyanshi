---
// src/pages/architecture/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

// 五大金刚底层核心架构矩阵
const pillars = [
  {
    num: '01',
    title: '专线物理拓扑测绘与中继调度',
    subtitle: 'Physical Optical & Point-to-Point Backbones',
    badge: '物理层',
    desc: '绕过公网多运营商复杂路由与恶性中转，采用点对点波分光纤独享专线。构建端内延迟严格可预测的私有跨域通信网络。首选 #1 环球梯广港/沪日专线。',
    specs: [
      { name: '传输介质', val: 'DWDM / 物理独享光纤' },
      { name: '平均往返抖动', val: '< 0.4ms' },
      { name: '典型路由', val: '深圳 ↔ 香港 / 上海 ↔ 东京' },
      { name: '抗干扰评级', val: '物理级免疫公网 QoS' },
    ],
  },
  {
    num: '02',
    title: '传输协议矩阵与魔改拥塞控制',
    subtitle: 'Next-Gen Protocol Stack & Congestion Control',
    badge: '传输层',
    desc: '摆脱传统单流 TCP Cubic 算法的窗口锯齿回退。在恶劣高丢包长延迟链路中，结合 Hysteria2 / QUIC 与 BBRv3 达到物理带宽饱和利用率。',
    specs: [
      { name: '拥塞算法', val: 'Google BBRv3 / FQ' },
      { name: '动态特性', val: 'UDP 端口随机动态跳跃' },
      { name: '握手耗时', val: '0-RTT 快速会话恢复' },
      { name: '弱网保留比', val: '20% 丢包下保留 90%+ 吞吐' },
    ],
  },
  {
    num: '03',
    title: '全球 Anycast 边缘调度与动态容灾',
    subtitle: 'Anycast BGP Convergence & Edge Routing',
    badge: '网络层',
    desc: '基于自建独立自治系统 (ASN)，单一 IP 地址向全球数十个 Tier-1 骨干 PoP 广播路由。当某条海底光缆割接时，BGP 路由毫秒级自主切流。',
    specs: [
      { name: '全球接入点', val: '48+ 核心互联 PoP' },
      { name: '故障切换时效', val: '< 500ms 链路自愈' },
      { name: 'DNS 调度机制', val: 'EDNS-Client-Subnet 权重' },
      { name: 'DDoS 防御', val: '全球边缘流量近源清洗' },
    ],
  },
  {
    num: '04',
    title: '内核级网络栈队列管理与调优规范',
    subtitle: 'Kernel-Level Bufferbloat Prevention & Sysctl',
    badge: '操作系统层',
    desc: '彻底根治大 BDP 链路中的缓冲区膨胀 (Bufferbloat)。优化 Linux 网络内核参数，配合 FQ-Codel 队列纪律实现微秒级延迟响应。',
    specs: [
      { name: '推荐内核', val: 'Linux 6.8+ LTS' },
      { name: 'TCP 缓冲区', val: '最大扩展至 64MB' },
      { name: '队列调度器', val: 'fq / fq_codel / CAKE' },
      { name: 'TCP Fast Open', val: '双向服务端/客户端启用' },
    ],
  },
  {
    num: '05',
    title: '金刚双轮驱动防灾拓扑（主力+备用）',
    subtitle: 'Dual-Wheel Redundancy & Hot Standby',
    badge: '应用架构层',
    desc: '绝不依赖单一机场服务商。以 #1 环球梯等高品质纯专线为第一主力核心通道，同时在客户端配置不限时永久按量包作为零秒接管备用池。',
    specs: [
      { name: '第一主力', val: '#1 环球梯 (¥8.40/月起)' },
      { name: '第二容灾', val: '永久不过期按量储备池' },
      { name: '接管时效', val: '0 秒无感平滑切换' },
      { name: '可用性指标', val: '99.999% 全年无离线' },
    ],
  },
];

// 金刚架构 vs 传统公网网络全景对比
const architectureComparisons = [
  {
    metric: '晚高峰丢包率 (Packet Loss)',
    traditional: '15% ~ 30% (TCP频繁重传)',
    kingkong: '0.00% (物理端内专线保障)',
    status: '提升 100%',
  },
  {
    metric: '4K/8K 视频首帧缓冲耗时',
    traditional: '3.5s ~ 8.0s (频繁缓冲圈)',
    kingkong: '< 280ms (秒拉即开)',
    status: '极速提升 92%',
  },
  {
    metric: '海缆故障中断自愈时延',
    traditional: '数小时至数天人工抢修',
    kingkong: '< 500ms Anycast 自动收敛',
    status: '毫秒级自动愈合',
  },
  {
    metric: 'IP 纯净度与欺诈评分',
    traditional: '机房 IP，欺诈分高达 70+',
    kingkong: '原生双 ISP 住宅出口，欺诈分 0',
    status: '防封通过率 100%',
  },
  {
    metric: 'AI 对话流式回包延迟 (TTFT)',
    traditional: '1200ms ~ 3000ms (停顿甚至报错)',
    kingkong: '180ms ~ 240ms (极致顺滑流式吐字)',
    status: '体验质变',
  },
];
---

<BaseLayout
  title="金刚架构 // 5 大底层网络技术矩阵与高可用容灾标准 · ANTIGRAVITY"
  description="深度拆解反重力五大金刚底层网络架构：物理专线测绘、现代协议魔改、Anycast 全球调度、Linux 内核级队列规范与双轮驱动防灾拓扑。"
>
  <div class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 头部导言 -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
      <div>
        <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-md text-xs font-mono font-bold bg-indigo-500/10 text-indigo-600 dark:text-cyan-400 border border-indigo-500/20 mb-3">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span>// FIVE PILLARS OF KING-KONG ARCHITECTURE</span>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight text-slate-900 dark:text-white">
          金刚架构 · 五大核心网络工程技术矩阵
        </h1>
        <p class="mt-2 text-xs sm:text-sm text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
          由物理光纤底层向上传导至传输层、内核队列与客户端多路分流。五大金刚核心架构协同工作，构筑全天候晚高峰 0 丢包的极致跨域通信体系。
        </p>
      </div>

      <!-- 架构指标徽章 -->
      <div class="flex items-center space-x-3 px-3.5 py-2 rounded-xl bg-slate-100 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 text-xs font-mono shrink-0">
        <span class="flex items-center space-x-1.5 text-cyan-600 dark:text-cyan-400 font-semibold">
          <span class="pulse-indicator">
            <span class="pulse-indicator-dot"></span>
          </span>
          <span>SLA 99.999% 金刚高可用</span>
        </span>
        <span class="text-slate-300 dark:text-slate-700">|</span>
        <span class="text-slate-600 dark:text-slate-300 font-medium">端内纯物理光纤</span>
      </div>
    </div>

    <!-- 拓扑示意图 (极客全景工程拓扑) -->
    <div class="mb-14 p-6 sm:p-8 rounded-2xl bg-slate-900 text-slate-200 border border-slate-800 font-mono text-xs overflow-x-auto shadow-2xl">
      <div class="flex items-center justify-between mb-3 text-slate-400">
        <span class="font-bold text-cyan-400">// 金刚五大架构协同数据流向全景拓扑图</span>
        <span>STATUS: SYNCHRONIZED</span>
      </div>
      <pre class="text-cyan-300 leading-relaxed"><code>[用户本地终端 / 软路由网关] ──(WireGuard / mTLS 零信任通道)──► [智能前置接入汇聚点]
                                                                        │
        ┌───────────────────────────────────────────────────────────────┴────────────────────────────────┐
        ▼                                                                                                ▼
 [金刚 01: IPLC/IEPL 端内物理专线]                                                                [金刚 03: Anycast BGP 动态容灾]
 (首推 #1 环球梯 | 抖动 &lt; 0.4ms | 0% 晚高峰丢包)                                                   (全球 48+ PoP | 毫秒级自愈切流)
        │                                                                                                │
        └───────────────────────────────────────────────┬────────────────────────────────────────────────┘
                                                        ▼
                                    [金刚 02: 传输层魔改 &amp; BBRv3 加速引擎]
                                    (QUIC / Hysteria2 端口跳跃 | 动态饱和带宽)
                                                        ▼
                                    [金刚 04: Linux 6.8+ 内核队列 FQ-Codel]
                                    (64MB 扩展缓冲区 | 彻底消除 Bufferbloat 拥塞)
                                                        ▼
                                    [金刚 05: 双轮驱动高可用防灾架构]
                                    (主力专线环球梯 + 永久不过期备用池 0 秒冷备接管)
                                                        ▼
                                    [海外核心目标集群 / 原生住宅双 ISP / 模型推理 API]</code></pre>
    </div>

    <!-- 五大金刚详细卡片矩阵 -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {pillars.map((pillar) => (
        <div class="p-6 sm:p-7 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/90 dark:bg-slate-900/70 hover:border-cyan-500/60 dark:hover:border-cyan-500/50 hover:shadow-xl transition-all flex flex-col justify-between backdrop-blur-sm">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="text-2xl font-black font-mono text-cyan-600 dark:text-cyan-400">
                // {pillar.num}
              </span>
              <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-50 dark:bg-cyan-950/80 text-cyan-600 dark:text-cyan-300 font-bold border border-cyan-200/60 dark:border-cyan-800/60">
                {pillar.badge}
              </span>
            </div>
            
            <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white">
              {pillar.title}
            </h2>
            <div class="text-[11px] font-mono text-slate-400 mt-0.5 mb-3">
              {pillar.subtitle}
            </div>
            
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              {pillar.desc}
            </p>
          </div>

          <div class="mt-5 pt-5 border-t border-slate-100 dark:border-slate-800">
            <div class="grid grid-cols-2 gap-2 text-xs font-mono">
              {pillar.specs.map((spec) => (
                <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-800">
                  <div class="text-slate-400 text-[10px]">{spec.name}</div>
                  <div class="font-bold text-slate-800 dark:text-slate-200 mt-0.5 text-[11px] truncate">{spec.val}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- 金刚架构 vs 传统公网网络性能压测总览表 -->
    <div class="mb-16">
      <div class="mb-6">
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
          📊 金刚架构 vs 传统公网中转性能实测对比
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          反重力实验室基于 72 小时晚高峰高压测试环境采集的真实硬核物理数据
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 shadow-xs">
        <table class="w-full text-left text-xs font-mono">
          <thead class="bg-slate-50 dark:bg-slate-800/60 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 uppercase">
            <tr>
              <th class="px-6 py-4 font-bold">核心压测指标</th>
              <th class="px-6 py-4 font-bold text-rose-500">传统公网中转 / 垃圾机场</th>
              <th class="px-6 py-4 font-bold text-cyan-500">金刚专线架构 (#1 环球梯)</th>
              <th class="px-6 py-4 font-bold text-emerald-500">效能质变</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-slate-700 dark:text-slate-300">
            {architectureComparisons.map((item) => (
              <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors">
                <td class="px-6 py-4 font-bold text-slate-900 dark:text-white">
                  {item.metric}
                </td>
                <td class="px-6 py-4 text-slate-500 dark:text-slate-400">
                  {item.traditional}
                </td>
                <td class="px-6 py-4 font-bold text-cyan-600 dark:text-cyan-400">
                  {item.kingkong}
                </td>
                <td class="px-6 py-4 font-bold text-emerald-600 dark:text-emerald-400">
                  <span class="px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800">
                    {item.status}
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- 内核调优实操代码与客户端分流配置模板 -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-16">
      
      <!-- 生产级 Linux 内核调优 -->
      <div class="p-6 sm:p-7 rounded-2xl bg-gradient-to-br from-slate-900 to-slate-950 text-slate-200 border border-slate-800 shadow-xl">
        <h3 class="text-sm sm:text-base font-bold text-white mb-1 flex items-center space-x-2">
          <span>⚙️ 金刚 04 标准生产级 Sysctl 配置参数</span>
        </h3>
        <p class="text-[11px] text-slate-400 mb-3 font-mono">
          适用于 Ubuntu 24.04 / Debian 12 / Rocky Linux 9 (Linux Kernel &gt;= 6.8)
        </p>

        <pre class="p-4 rounded-xl bg-black/60 text-emerald-400 font-mono text-[11px] overflow-x-auto leading-relaxed border border-slate-800"><code># /etc/sysctl.d/99-antigravity-core.conf
net.core.default_qdisc = fq
net.ipv4.tcp_congestion_control = bbr
net.core.rmem_max = 67108864
net.core.wmem_max = 67108864
net.ipv4.tcp_rmem = 4096 87380 67108864
net.ipv4.tcp_wmem = 4096 65536 67108864
net.ipv4.tcp_fastopen = 3
net.core.netdev_max_backlog = 100000</code></pre>
      </div>

      <!-- 客户端金刚智能分流规则模板 -->
      <div class="p-6 sm:p-7 rounded-2xl bg-gradient-to-br from-slate-900 to-slate-950 text-slate-200 border border-slate-800 shadow-xl">
        <h3 class="text-sm sm:text-base font-bold text-white mb-1 flex items-center space-x-2">
          <span>🛡️ 金刚 05 客户端智能双轮分流策略</span>
        </h3>
        <p class="text-[11px] text-slate-400 mb-3 font-mono">
          适用于 Clash Verge Rev / Sing-box / OpenClash 订阅分流规则
        </p>

        <pre class="p-4 rounded-xl bg-black/60 text-cyan-300 font-mono text-[11px] overflow-x-auto leading-relaxed border border-slate-800"><code># 金刚分流策略组结构
proxy-groups:
  - name: 🚀 主力金刚通道
    type: select
    proxies:
      - 👑 环球梯-广港专线01 (HQ66)
      - 👑 环球梯-沪日专线01 (HQ66)
  - name: 🛡️ 应急冷备接管
    type: fallback
    url: 'http://cp.cloudflare.com/generate_204'
    interval: 30
    proxies:
      - 🚀 主力金刚通道
      - 环球梯-永久按量备用包</code></pre>
      </div>

    </div>

    <!-- 底部实战总结 -->
    <div class="p-6 rounded-2xl bg-gradient-to-r from-cyan-500/10 via-blue-500/10 to-indigo-500/10 border border-cyan-500/20 text-center max-w-3xl mx-auto font-mono text-xs text-slate-600 dark:text-slate-400">
      <div class="font-bold text-slate-900 dark:text-white mb-1.5 text-sm flex items-center justify-center space-x-2">
        <span>⚡ 金刚架构工程落地结论</span>
      </div>
      <p>
        五大金刚体系不仅是理论标准，更是可复现的工程实践。推荐在客户端以 <strong>#1 环球梯 (HuanQiuTi)</strong> 专线为主轴构建智能分流矩阵，享受端到端 0 丢包的极致顺畅跨境体验。
      </p>
    </div>

  </div>
</BaseLayout>
