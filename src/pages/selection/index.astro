<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.scenario-btn');
    const cards = document.querySelectorAll('.scenario-card');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');

        buttons.forEach(b => {
          b.classList.remove('active', 'bg-blue-600', 'text-white', 'border-blue-600', 'shadow-md', 'shadow-blue-500/20');
          b.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-200', 'border-slate-200', 'dark:border-slate-700');
        });

        btn.classList.add('active', 'bg-blue-600', 'text-white', 'border-blue-600', 'shadow-md', 'shadow-blue-500/20');
        btn.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-200', 'border-slate-200', 'dark:border-slate-700');

        cards.forEach(card => {
          if (card.id === `scenario-card-${targetId}`) {
            card.classList.remove('hidden');
            card.classList.add('flex');
          } else {
            card.classList.add('hidden');
            card.classList.remove('flex');
          }
        });
      });
    });
  });
</script>
