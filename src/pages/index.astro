<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.querySelector('.copy-home-coupon');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const code = copyBtn.getAttribute('data-coupon') || 'HQ66';
        try {
          await navigator.clipboard.writeText(code);
        } catch (_) {
          const input = document.createElement('input');
          input.value = code;
          document.body.appendChild(input);
          input.select();
          document.execCommand('copy');
          document.body.removeChild(input);
        }

        const originalText = copyBtn.innerText;
        copyBtn.innerText = '✓ 已复制 HQ66!';
        copyBtn.classList.add('bg-emerald-400', 'text-slate-950');
        setTimeout(() => {
          copyBtn.innerText = originalText;
          copyBtn.classList.remove('bg-emerald-400');
        }, 2000);
      });
    }
  });
</script>
